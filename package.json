{
  "name": "canvas-model-ia",
  "version": "0.1.0",
  "private": true,
  "description": "Business Model Canvas con análisis IA seguro",
  "author": "Canvas Model IA",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:html": "vite --config vite.electron.config.ts build",
    "build:desktop": "npm run build:html",
    "start": "vinext start",
    "test": "npm run build && npm run build:html && node --experimental-strip-types --test tests/phase1.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern .vercel",
    "db:generate": "drizzle-kit generate",
    "electron:dev": "npm run build:html && electron electron/main.cjs",
    "build:exe": "npm run build:html && electron-builder --win portable --x64",
    "build:exe:unpacked": "npm run build:html && electron-builder --win --x64 --dir",
    "verify:exe": "node scripts/verify-exe.mjs",
    "package:final": "npm run build:exe && npm run verify:exe"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "nitro": "^3.0.260903-beta",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^38.8.6",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "vite-plugin-singlefile": "^2.3.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "build": {
    "appId": "pe.canvasmodelia.app",
    "productName": "Canvas Model IA",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/electron/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Canvas-Model-IA-portable-${version}-${arch}.${ext}"
    }
  }
}
